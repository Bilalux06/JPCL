{
  "kind": "collectionType",
  "collectionName": "tenders",
  "info": {
    "singularName": "tender",
    "pluralName": "tenders",
    "displayName": "Tender",
    "description": "Tender management with automatic expiry logic"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Reference_ID": {
      "type": "string",
      "required": true
    },
    "Title": {
      "type": "string",
      "required": true
    },
    "Description": {
      "type": "richtext"
    },
    "Closing_Date": {
      "type": "datetime",
      "required": true
    },
    "Opening_Date": {
      "type": "datetime",
      "default": null
    },
    "Status": {
      "type": "enumeration",
      "enum": ["draft", "active", "expired", "cancelled", "awarded"],
      "default": "draft"
    },
    "Category": {
      "type": "enumeration", 
      "enum": ["procurement", "services", "works", "consultancy", "other"],
      "default": "procurement"
    },
    "Estimated_Value": {
      "type": "decimal"
    },
    "Currency": {
      "type": "string",
      "default": "PKR"
    },
    "Attachment": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos", 
        "audios"
      ]
    },
    "Contact_Person": {
      "type": "string"
    },
    "Contact_Email": {
      "type": "email"
    },
    "Contact_Phone": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  }
}

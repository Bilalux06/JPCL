{
  "kind": "singleType",
  "collectionName": "site-settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings", 
    "displayName": "Site Settings",
    "description": "Global site settings, logos and content"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "site_name": {
      "type": "string",
      "default": "Jamshoro Power Company Limited"
    },
    "site_tagline": {
      "type": "string",
      "default": "Company Ltd(Genco-1)"
    },
    "main_logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "footer_logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "government_entity": {
      "type": "string",
      "default": "Govt. of Pakistan Entity"
    },
    "iso_certified": {
      "type": "string",
      "default": "ISO Certified"
    },
    "contact_info": {
      "type": "component",
      "repeatable": false,
      "component": "global.contact-info"
    },
    "social_media": {
      "type": "component",
      "repeatable": true,
      "component": "global.social-media"
    },
    "hero_slides": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "quick_links": {
      "type": "component",
      "repeatable": true,
      "component": "global.quick-links"
    }
  }
}
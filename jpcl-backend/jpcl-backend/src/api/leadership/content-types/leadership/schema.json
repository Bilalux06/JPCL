{
  "kind": "collectionType",
  "collectionName": "leaderships",
  "info": {
    "singularName": "leadership",
    "pluralName": "leaderships",
    "displayName": "Leadership",
    "description": "Leadership team members with photos and messages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "designation": {
      "type": "string",
      "required": true
    },
    "message": {
      "type": "richtext"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "order": {
      "type": "integer",
      "default": 1
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}
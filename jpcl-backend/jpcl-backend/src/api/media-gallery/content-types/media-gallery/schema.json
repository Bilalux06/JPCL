{
  "kind": "collectionType",
  "collectionName": "media-galleries",
  "info": {
    "singularName": "media-gallery",
    "pluralName": "media-galleries",
    "displayName": "Media Gallery",
    "description": "Media gallery with videos and images"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "media_files": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": ["images", "videos"]
    },
    "category": {
      "type": "enumeration",
      "enum": ["photos", "videos", "documents", "presentations"],
      "default": "photos"
    },
    "event_date": {
      "type": "date"
    },
    "location": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 1
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  }
}